# ===== WAJIB — Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== OPSIONAL — alamat situs (default: https://invisual.studio) =====
# NEXT_PUBLIC_SITE_URL=https://invisual.studio

# ===== OPSIONAL — notifikasi email (Resend) untuk Pesan & Proyek Masuk =====
# RESEND_API_KEY=
# CONTACT_NOTIFY_TO=business@invisual.studio
# CONTACT_NOTIFY_FROM=Invisual <onboarding@resend.dev>

# ===== OPSIONAL — pengiriman URL artikel blog ke mesin pencari =====
# Google Indexing API (service account harus Owner di Search Console):
# GOOGLE_INDEXING_CLIENT_EMAIL=
# GOOGLE_INDEXING_PRIVATE_KEY=
# IndexNow (Bing, Yandex, dll.) — string acak 32 karakter huruf/angka:
# INDEXNOW_KEY=

# ===== OPSIONAL — unggah gambar blog langsung dari editor admin ke Cloudinary =====
# Ambil di Cloudinary Console → Settings → API Keys. Nama cloud tertera di pojok
# kiri atas Console (akun admin Invisual: "vig1hayb"). Key & secret harus dari
# cloud yang sama. Tanpa ini, editor tetap jalan tapi gambar harus ditempel URL.
# CLOUDINARY_CLOUD_NAME=vig1hayb
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
