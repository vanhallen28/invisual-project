# ===== WAJIB — Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== OPSIONAL — alamat situs (default: https://invisual.studio) =====
# NEXT_PUBLIC_SITE_URL=https://invisual.studio

# ===== OPSIONAL — notifikasi email (Resend) untuk Pesan & Proyek Masuk =====
# RESEND_API_KEY=
# CONTACT_NOTIFY_TO=business@invisual.studio
# CONTACT_NOTIFY_FROM=Invisual <onboarding@resend.dev>

# ===== OPSIONAL — pengiriman URL artikel blog ke mesin pencari =====
# Google Indexing API (service account harus Owner di Search Console):
# GOOGLE_INDEXING_CLIENT_EMAIL=
# GOOGLE_INDEXING_PRIVATE_KEY=
# IndexNow (Bing, Yandex, dll.) — string acak 32 karakter huruf/angka:
# INDEXNOW_KEY=

# ===== Cloudinary — unggah gambar dari admin (Karya, Tim, Klien, Blog) =====
# Nama cloud ada di pojok kiri atas Cloudinary Console (akun Invisual: vig1hayb).
# Preset UNSIGNED: Console → Settings → Upload → Upload presets (Signing mode: Unsigned).
# Dua variabel ini sudah dipakai unggah Karya; editor Blog memakai yang sama.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=vig1hayb
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# OPSIONAL — hanya untuk GALERI gambar di editor blog (daftar media lewat Admin API).
# Key harus punya izin penuh (Master). Tidak diperlukan untuk unggah.
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_CLOUD_NAME=vig1hayb   (opsional; default mengikuti NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME)
